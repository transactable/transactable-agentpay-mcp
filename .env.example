# --- Required: where the MCP sends requests ---
# Alchemy AgentPay proxy base URL for the Transactable project.
# Find this in your AgentPay dashboard under each endpoint's "Proxy URL".
# Format:
#   https://agent-proxy.alchemy.com/v1/<rail>/<project_id>
# where <rail> is one of: x402-testnet, x402-mainnet, mpp-stripe.
TRANSACTABLE_AGENTPAY_BASE_URL="https://agent-proxy.alchemy.com/v1/x402-testnet/11488ccf8e53b480"

# --- Required: wallet used to pay per call ---
# Hex private key (with or without 0x prefix) for an EVM wallet
# that holds USDC on the network AgentPay is charging on.
# For local dev / testnet, generate one with `cast wallet new` (foundry)
# or any EVM wallet tool. Never commit this value.
TRANSACTABLE_WALLET_PRIVATE_KEY=""

# --- Optional: self-declared agent identity ---
# Sent in the request body as `agent_name`. Helps you track which agent
# made which registration in your AgentAccount records.
TRANSACTABLE_AGENT_NAME=""

# Optional JSON blob describing the model running this agent.
# Example: {"model":"claude-sonnet-4-6","operator":"acme-corp"}
TRANSACTABLE_MODEL_INFO=

# --- Optional: HTTP behavior ---
# Per-request timeout in seconds (default: 60).
TRANSACTABLE_HTTP_TIMEOUT=60

# Set to 1 to log raw proxy responses to stderr. Off in production.
TRANSACTABLE_DEBUG=0
